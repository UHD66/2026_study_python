      "source": [
        "import numpy\n",
        "from sklearn.linear_model import LinearRegression as LR\n",
        "\n",
        "X=numpy.array([[10],[20],[30],[40],[50]])\n",
        "y=numpy.array([122,232,344,445,535])\n",
        "\n",
        "model=LR()\n",
        "model.fit(X,y)\n",
        "\n",
        "A=numpy.array([[15]])\n",
        "\n",
        "B=model.predict(A)\n",
        "\n",
        "print(f\"{B[0]:.2f}\")\n"
      ],
