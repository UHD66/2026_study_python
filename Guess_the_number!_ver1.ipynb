      "source": [
        "import random\n",
        "a=random.randint(1,100)\n",
        "print(\"Guess the number!\")\n",
        "count=0\n",
        "while True:\n",
        "  count=count+1\n",
        "  b=int(input(\"Guess the number\"))\n",
        "  if a==b:\n",
        "    print(f\"It's a success on the {count} try!\")\n",
        "    break\n",
        "  elif a>b:\n",
        "    print(\"bigger\")\n",
        "  elif a<b:\n",
        "    print(\"smaller\")"
      ]
